{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PROJECT_ROOT": "${workspaceFolder}",
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/external:${workspaceFolder}/external/gsam2:${env:PYTHONPATH}"
            }
        }
    ]
}